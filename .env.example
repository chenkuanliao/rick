APP_HOST=127.0.0.1
APP_PORT=8000
PUBLIC_HTTPS_URL=https://gollum.tail7da960.ts.net
INSECURE_REDIRECT_HOSTS=100.102.145.67
PRELOAD_SPEECH_MODELS=false

# Default LLM provider.
DEFAULT_PROVIDER=nvidia
LLM_MAX_TOKENS=8192
LLM_RETRY_MAX_TOKENS=16384
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional providers.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=

OPENAI_COMPATIBLE_NAME=OpenAI-compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash
OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Local speech models.
STT_MODEL=Systran/faster-whisper-medium
STT_FALLBACK_MODEL=openai/whisper-base
STT_DEVICE=auto
STT_COMPUTE_TYPE=auto
STT_LANGUAGE=
STT_BEAM_SIZE=1
STT_VAD_FILTER=true

# Chatterbox voice generation.
TTS_TEMPERATURE=0.8
TTS_TOP_P=0.95
TTS_TOP_K=1000
TTS_REPETITION_PENALTY=1.2
TTS_NORM_LOUDNESS=true
TTS_DEVICE=auto
TTS_MAX_CHUNK_CHARS=900
TTS_FIRST_CHUNK_MIN_CHARS=180
TTS_NEXT_CHUNK_TARGET_CHARS=650
TTS_FIRST_CHUNK_MAX_SENTENCES=3
TTS_NEXT_CHUNK_MAX_SENTENCES=6

# Override only if ffmpeg is not on PATH.
FFMPEG_PATH=ffmpeg
